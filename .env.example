# Copy to .env.local and fill in. All of these are REQUIRED in production —
# the app now refuses to start rather than fall back to insecure defaults.

# Postgres (Neon). DIRECT_URL bypasses the pooler for migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# NextAuth session signing key. Generate with: openssl rand -base64 32
# Anyone who knows this value can forge an admin session.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Authorises the nightly /api/cron/backup job. Generate with: openssl rand -base64 32
# Set this in the Vercel project settings so Vercel Cron sends it automatically.
CRON_SECRET=""

# Optional: Ship24 API key for live carrier tracking. Without it the tracking
# timeline shows only events recorded by this system.
TRACKING_API_KEY=""
